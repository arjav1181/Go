{
  "name": "go-link-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --require ./tests/helpers/alias.cjs --test .test-dist/tests/*.test.js",
    "db:migrate": "sh -c 'set -e; for f in supabase/migrations/*.sql; do echo \"-> $f\"; psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -q -f \"$f\"; done; echo \"migrations applied\"'",
    "db:reset": "sh -c 'for f in supabase/migrations/*.sql; do psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -q -f \"$f\"; done'",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "check:fast": "bun test tests/ && tsc --noEmit && eslint .",
    "test:fast": "bun test tests/"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.103.1",
    "geist": "^1.7.2",
    "next": "16.4.1",
    "qr-code-styling": "^1.9.2",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.39",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
