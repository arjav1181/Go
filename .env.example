# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Public Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase anon/publishable key. Safe to expose to the browser: it is
# only ever used to sign in. All data access goes through the service role on
# the server, and row level security is enabled with no policies, so this key
# can read no rows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role key. NEVER prefix with NEXT_PUBLIC_, never
# send to the browser, never commit. It bypasses row level security, so treat a
# leak as a full database compromise and rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of verified owner email addresses. Anyone not on this
# list is refused, including holders of valid API keys.
OWNER_EMAILS=

# Canonical public URL. Used for redirects, metadata and OG tags.
NEXT_PUBLIC_APP_URL=https://go.arjav.is-cool.dev

# ---------------------------------------------------------------------------
# Required for the scheduled purge
# ---------------------------------------------------------------------------

# Shared secret for /api/cron/purge. At least 16 random characters. If unset the
# endpoint refuses to run rather than deleting data unauthenticated. Vercel Cron
# sends it automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Site URL used for canonical links, Open Graph tags, robots.txt and sitemap.xml.
# Defaults to the APP_URL above when unset.
NEXT_PUBLIC_SITE_URL=https://go.arjav.is-cool.dev

# Contact address shown in the footer.
NEXT_PUBLIC_CONTACT_EMAIL=hello@go.arjav.is-cool.dev

# Extra hostnames allowed to serve short links, comma-separated.
# Leave empty to disable alias domains (the default). The application never
# changes DNS or TLS; those are yours to configure.
ALIAS_DOMAINS=

# Salt for deterministic A/B bucketing. Changing it re-buckets all traffic
# across existing experiments, so treat it as effectively immutable once an
# experiment is live. No visitor identifier is hashed, only the link.
EXPERIMENT_SALT=

# Default API requests per key per minute. Per-key budgets are also enforced in
# Postgres and hold across instances; this variable tunes the default only.
API_RATE_LIMIT_PER_MINUTE=60

# Per-scope overrides. Name is RATE_LIMIT_<SCOPE>:
#   RATE_LIMIT_LOGIN=10          sign-in attempts (per caller AND per account)
#   RATE_LIMIT_LINK_CREATE=30    link creation
#   RATE_LIMIT_LINK_EDIT=120     link edits
#   RATE_LIMIT_QR=30             QR generation
#   RATE_LIMIT_EXPORT=10         CSV export
#   RATE_LIMIT_REDIRECT=600      failed redirects only
#
# Counters live in Postgres. If the store is unreachable the limiter fails open
# on nonessential paths so a redirect is never blocked. See THREAT-MODEL.md.

# Log verbosity: debug | info | warn | error. Default info.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Not needed
# ---------------------------------------------------------------------------
#
# Tags, folders, CSV export and the analytics date-range filters all use the
# same Supabase project above. There are no additional variables for them.
#
# Every file in supabase/migrations/ must be applied, in order, before use:
#   npm run db:migrate   (requires SUPABASE_DB_URL — see README)
